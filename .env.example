# ---------------------------------------------------------------------------
# Database (MySQL 8)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://knights:knights@localhost:3306/knightscoaches?connection_limit=3&pool_timeout=20"

# ---------------------------------------------------------------------------
# Auth (NextAuth v5)
#   NEXTAUTH_SECRET: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public site origin — used for canonicals, sitemaps, OG URLs and IndexNow.
NEXT_PUBLIC_SITE_URL="https://knightscoaches.com"

# ---------------------------------------------------------------------------
# Seeded admin account (prisma/seed.ts)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="info@knightscoaches.com"
ADMIN_PASSWORD="change-this-before-deploying"
ADMIN_NAME="Knights Coaches Admin"

# ---------------------------------------------------------------------------
# Outbound mail (Nodemailer). Submissions are stored in MySQL whether or not
# delivery succeeds, so these may be left blank in development.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Knights Coaches <no-reply@knightscoaches.com>"
FORM_NOTIFY_EMAIL="info@knightscoaches.com"

# ---------------------------------------------------------------------------
# Indexing
#   INDEXNOW_KEY: 8-128 hex chars. The key file is served at /<key>.txt.
#   GOOGLE_INDEXING_SA_JSON: the whole service-account JSON on one line.
#     Google officially restricts this API to JobPosting and BroadcastEvent —
#     see README. Sitemap + Search Console stays the primary path here.
# ---------------------------------------------------------------------------
INDEXNOW_KEY=""
GOOGLE_INDEXING_SA_JSON=""

# ---------------------------------------------------------------------------
# Optional spam protection for public forms (Turnstile or reCAPTCHA v3).
# Leave blank to run with honeypot + rate limiting only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# WordPress migration source (scripts/migrate-wordpress.ts)
# ---------------------------------------------------------------------------
WP_SOURCE_URL="https://knightscoaches.com"
